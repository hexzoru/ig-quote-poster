# ---- Groq (free LLM for quote/topic generation) ----
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Instagram Graph API ----
IG_USER_ID=your_instagram_business_account_id
IG_ACCESS_TOKEN=your_long_lived_access_token

# ---- GitHub (used to host generated images at a public raw URL) ----
# This is a Personal Access Token with "repo" scope on the repo below.
# Inside GitHub Actions, you can just use the automatic GITHUB_TOKEN instead (see workflow file).
GH_TOKEN=your_github_pat_here
GH_OWNER=your_github_username
GH_REPO=ig-quote-poster
GH_BRANCH=main

# Instagram caption "signature" appended to every post (edit freely)
IG_HANDLE=@your_instagram_handle
